---
import { getCollection, type CollectionEntry } from "astro:content";
import ImageMod from "@/components/ImageMod.astro";
import {
  formatFloatingDateTime,
  formatFloatingMonthDay,
  getEasternNow,
  isSameFloatingDay,
  parseFloatingIso,
} from "@/lib/utils/floatingDate";

type EventEntry = CollectionEntry<"events">;

interface Props {
  limit?: number;
  title?: string;
  showCalendarCta?: boolean;
  calendarHref?: string;
  containerClass?: string;
  /** Render without the outer section/container so a parent layout can place it. */
  embedded?: boolean;
  gridClass?: string;
}

const {
  limit = 4,
  title = "Upcoming Events",
  showCalendarCta = true,
  calendarHref = "/calendar/",
  containerClass = "container px-6 max-w-[1400px] mx-auto",
  embedded = false,
  gridClass = "grid gap-6 md:grid-cols-2 xl:grid-cols-4 mt-6",
} = Astro.props;

const Wrapper = embedded ? "div" : "section";
const innerClass = embedded ? "flex flex-col h-full" : containerClass;

// Load all events from the content collection
const coll: EventEntry[] = await getCollection("events");

// Helpers
const now = getEasternNow();
const parseDate = (v: unknown) => parseFloatingIso(v as string | Date | null | undefined) ?? undefined;

function inFutureOrOngoing(e: EventEntry) {
  const start = parseDate(e.data.date);
  const end = parseDate((e.data as any).endDate);
  if (!start) return false;
  return start >= now || (end && end >= now);
}

function fmtRange(e: EventEntry) {
  const s = parseDate(e.data.date);
  const end = parseDate((e.data as any).endDate);
  if (!s) return "TBD";
  if (!end || isSameFloatingDay(s, end)) {
    return formatFloatingDateTime(s);
  }
  const S = formatFloatingMonthDay(s);
  const E = formatFloatingMonthDay(end);
  return `${S}-${E}`;
}

// Derive a base title by stripping leading/trailing month names so recurring
// events like "January Fox Hunt" and "February Fox Hunt" share the same key.
const MONTHS = /^(january|february|march|april|may|june|july|august|september|october|november|december)\s+/i;
function baseTitle(title: string) {
  return title.replace(MONTHS, "").trim().toLowerCase();
}

// Filter, sort, deduplicate recurring series, then limit
const seen = new Set<string>();
const upcoming = coll
  .filter(inFutureOrOngoing)
  .sort((a, b) => {
    const da = parseDate(a.data.date)?.getTime() ?? 0;
    const db = parseDate(b.data.date)?.getTime() ?? 0;
    return da - db;
  })
  .filter((e) => {
    const key = baseTitle(e.data.title);
    if (seen.has(key)) return false;
    seen.add(key);
    return true;
  })
  .slice(0, limit);
---

{(upcoming.length > 0 || embedded) && (
  <Wrapper>
    <div class={innerClass}>
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="eyebrow mb-2">On the calendar</p>
          <h2 class="section-title mb-0! before:hidden">{title}</h2>
        </div>
        {showCalendarCta && (
          <a class="btn-ghost shrink-0" href={calendarHref}>
            All events <span aria-hidden="true">→</span>
          </a>
        )}
      </div>

      {upcoming.length === 0 && (
        <div class="w4-card mt-6 flex-1">
          <p>No events scheduled right now. Check the <a class="underline" href={calendarHref}>events page</a> for updates.</p>
        </div>
      )}
      <div class={gridClass}>
        {upcoming.map((ev) => {
          const cover = (ev.data as any).cover as string | undefined;
          const location = (ev.data as any).location as string | undefined;
          const summary = (ev.data as any).summary as string | undefined;
          const url = (ev.data as any).url ?? `/${ev.collection}/${ev.id}/`;
          const rsvpUrl = (ev.data as any).rsvpUrl as string | undefined;
          return (
            <div class:list={["w4-card w4-card-link relative", embedded ? "sm:flex sm:gap-5 sm:items-start p-4!" : "block"]}>
              {cover && (
                <ImageMod
                  src={cover}
                  width={640}
                  height={360}
                  format="webp"
                  alt=""
                  class:list={["mb-3 rounded-xl", embedded && "sm:mb-0 sm:w-44 sm:shrink-0"]}
                  style="aspect-ratio:16/9;object-fit:cover;"
                  loading="lazy"
                />
              )}
              <div>
              <div class="font-mono text-xs uppercase tracking-wider text-(--w4-accent) mb-1.5">{fmtRange(ev)}</div>
              <h3 class="text-white font-semibold text-lg leading-snug">{ev.data.title}</h3>
              {location && (
                <p class="mt-1 text-sm text-white/55!">{location}</p>
              )}
              {summary && <p class="mt-2 text-sm text-white/75!">{summary}</p>}
              <div class="mt-3 flex flex-wrap gap-3">
                {rsvpUrl && (
                  <a
                    class="link-arrow relative z-10"
                    href={rsvpUrl}
                  >
                    RSVP
                  </a>
                )}
                <a
                  class="link-arrow after:absolute after:inset-0 after:content-['']"
                  href={url}
                >
                  More info <span aria-hidden="true">→</span>
                </a>
              </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </Wrapper>
)}
