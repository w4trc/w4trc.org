---
import repeaters from "@/data/repeaters.json";

// Repeater status lives in src/data/repeaters.json so this strip and the
// Repeaters page stay in sync. status.onAir tracks the primary 2m machine (and
// the Sunday net); each clubOnAir entry has its own onAir flag for its badge.
// status.message is shown whenever it is set, so clear it once all are back.
const isOnAir = repeaters.status?.onAir !== false;
const statusMessage = repeaters.status?.message ?? "";

const items = [
  { label: "Club Repeater", value: "146.970 (−) PL 123.0" },
  { label: "Sunday Net", value: isOnAir ? "8:30 PM" : "On hold" },
  { label: "EchoLink", value: "W4TRC-R", href: "/repeaters/echolink/" },
  { label: "Grid", value: "EM86" },
];
---

<div class="relative z-10 -mt-20 container max-w-[1400px] px-6 mx-auto">
  <div class="w4-card p-5! lg:px-7! backdrop-blur-xl bg-[#0d1321]/80!">
    <div class="flex max-lg:flex-col lg:items-center max-lg:gap-5 lg:gap-10">
      <div class="flex items-center gap-3 lg:min-w-[230px] lg:border-r lg:border-white/10 lg:pr-8">
        <span class:list={["live-dot", !isOnAir && "is-off"]} aria-hidden="true"></span>
        <div>
          <p class="font-secondary text-white font-semibold leading-tight">
            {isOnAir ? "On the Air" : "Repeaters Offline"}
          </p>
          {statusMessage && (
            <p class="text-xs text-white/55! mt-1">{statusMessage}</p>
          )}
        </div>
      </div>

      <dl class="grid grid-cols-2 sm:flex sm:flex-wrap gap-x-10 gap-y-4 flex-1">
        {items.map((item) => (
          <div>
            <dt class="font-mono text-[10px] uppercase tracking-[.16em] text-white/45">{item.label}</dt>
            <dd class="text-white font-mono font-medium mt-1 whitespace-nowrap">
              {item.href ? (
                <a class="underline underline-offset-4 decoration-white/25 hover:decoration-current" href={item.href}>{item.value}</a>
              ) : (
                item.value
              )}
            </dd>
          </div>
        ))}
      </dl>

      <a href="/repeaters/" class="btn-ghost whitespace-nowrap self-start lg:self-auto">
        Repeater details <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</div>
