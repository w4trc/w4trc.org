---
import type { CollectionEntry } from "astro:content";
import ImageMod from "@/components/ImageMod.astro";

interface Props {
  post: CollectionEntry<"posts">;
  headingLevel?: "h2" | "h3";
  /** Large horizontal card for the newest post */
  featured?: boolean;
}

const { post, headingLevel = "h2", featured = false } = Astro.props;
const Heading = headingLevel;

const href = post.data.externalUrl ?? `/posts/${post.id.replace(/\/index$/, "")}/`;
const isExternal = !!post.data.externalUrl;

const fmtDate = (iso: string) =>
  new Date(iso + "T00:00:00").toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<article class:list={["group w4-card w4-card-link relative flex flex-col overflow-hidden", featured && "lg:flex-row"]}>
  {post.data.image && (
    <div class:list={["overflow-hidden", featured && "lg:w-[58%] lg:shrink-0"]}>
    <ImageMod
      src={post.data.image}
      alt={post.data.title}
      width={featured ? 1200 : 800}
      height={featured ? 720 : 384}
      format="webp"
      class={`w-full h-52 object-cover transition-transform duration-500 group-hover:scale-[1.04] ${featured ? "sm:h-72 lg:h-full lg:min-h-[360px]" : ""}`}
      loading={featured ? "eager" : "lazy"}
    />
    </div>
  )}
  <div class:list={["p-6 flex flex-col gap-3 flex-1", featured && "lg:justify-center lg:p-10"]}>
  {featured && <div class="eyebrow">Latest post</div>}
  <div class="flex items-center gap-2 flex-wrap">
    <time
      datetime={post.data.date}
      class="text-xs text-white/45 font-mono tracking-wide"
    >
      {fmtDate(post.data.date)}
    </time>
    {post.data.tags?.map((tag) => (
      <span class="text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full border border-white/10 bg-white/5 text-white/70">
        {tag.replace(/-/g, " ")}
      </span>
    ))}
  </div>

  <Heading class:list={[featured ? "text-2xl lg:text-3xl" : "text-xl", "font-semibold text-white leading-snug group-hover:text-(--w4-accent) transition-colors"]}>
    <a
      href={href}
      class="focus:outline-none after:absolute after:inset-0 after:content-[''] focus-visible:after:ring-2 focus-visible:after:ring-[var(--w4-accent)] focus-visible:after:rounded-2xl"
      {...isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {}}
    >
      {post.data.title}
    </a>
  </Heading>

  {post.data.author && (
    <p class="text-sm text-white/55! font-medium">
      {post.data.author}
    </p>
  )}

  {post.data.summary && (
    <p class:list={[featured ? "text-base line-clamp-4" : "text-sm line-clamp-3", "text-white/70!"]}>
      {post.data.summary}
    </p>
  )}

  <span
    class="link-arrow mt-auto pt-1"
    aria-hidden="true"
  >
    Read more
    {isExternal ? (
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5" aria-hidden="true">
        <path d="M12.5 3a.75.75 0 000 1.5h2.19l-6.72 6.72a.75.75 0 101.06 1.06l6.72-6.72v2.19a.75.75 0 001.5 0v-4a.75.75 0 00-.75-.75h-4z" />
        <path d="M4.75 5.5A1.25 1.25 0 003.5 6.75v8A1.25 1.25 0 004.75 16h8a1.25 1.25 0 001.25-1.25v-3.5a.75.75 0 00-1.5 0v3.5H5v-8h3.5a.75.75 0 000-1.5h-3.75z" />
      </svg>
    ) : (
      <span>→</span>
    )}
  </span>
  </div>
</article>
