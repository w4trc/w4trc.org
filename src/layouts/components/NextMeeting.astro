---
import { getCollection } from "astro:content";
import {
  formatFloatingDateTime,
  getEasternNow,
  parseFloatingIso,
} from "@/lib/utils/floatingDate";

interface Meeting {
  title?: string;
  datetime?: string | Date;   // ISO string recommended
  location?: string;
  topic?: string;
  desc?: string;
  signupUrl?: string;
  draft?: boolean;
}

interface Props {
  meeting?: Meeting;   // optional override
}

// If a meeting prop is passed, use it; otherwise pull the next meeting from the collection.
let source: Meeting | undefined = Astro.props.meeting;
if (!source) {
  try {
    const meetings = await getCollection("meetings");
    const parsed = meetings
      .filter((m) => !m.data.draft && m.data.datetime)
      .map((m) => {
        return { ...m.data, datetime: m.data.datetime };
      })
      .filter((m) => !!parseFloatingIso(m.datetime))
      .sort((a, b) => {
        const da = parseFloatingIso(a.datetime)?.getTime() ?? 0;
        const db = parseFloatingIso(b.datetime)?.getTime() ?? 0;
        return da - db;
      });

    const now = getEasternNow().getTime();
    const upcoming = parsed.find((m) => (parseFloatingIso(m.datetime)?.getTime() ?? 0) >= now);
    source = upcoming || parsed[parsed.length - 1];
  } catch (e) {
    try {
      const m = await import("@/data/meetings.json");
      source = (m.default || m) as Meeting;
    } catch {
      source = {};
    }
  }
}

// Helpers
const title = source?.title || "Club Meeting";
const location = source?.location || "TBD";
const topic = source?.topic;
const desc = source?.desc;

function formatDate(dt?: string | Date) {
  if (!dt) return "TBD";
  return formatFloatingDateTime(dt);
}

const when = formatDate(source?.datetime);
const signupUrl = source?.signupUrl;

// "Venue Name (123 Street, City, ST 00000)" -> venue + address
const locMatch = /^(.*?)\s*\((.+)\)\s*$/.exec(location);
const venue = locMatch ? locMatch[1] : location;
const address = locMatch ? locMatch[2].replace(/\s+/g, " ") : "";
const mapUrl =
  location !== "TBD"
    ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address || location)}`
    : undefined;

// Google Calendar link. Meeting times are floating Eastern times, so pass the
// wall-clock fields with ctz rather than converting to UTC. Assumes 2 hours.
const start = parseFloatingIso(source?.datetime);
let calendarUrl: string | undefined;
if (start) {
  const end = new Date(start.getTime() + 2 * 60 * 60 * 1000);
  const fmt = (d: Date) => d.toISOString().replace(/[-:]/g, "").slice(0, 15);
  const params = new URLSearchParams({
    action: "TEMPLATE",
    text: `KARC ${title}`,
    dates: `${fmt(start)}/${fmt(end)}`,
    ctz: "America/New_York",
    details: [topic && `Program: ${topic}`, desc, "https://w4trc.org/meetings/"].filter(Boolean).join("\n"),
    location,
  });
  calendarUrl = `https://calendar.google.com/calendar/render?${params.toString()}`;
}

const btn = "px-4 py-2 rounded-xl border border-white/20 text-white/90 text-sm hover:border-white/40";
---

<div>
  <h2 class="section-title">Next Meeting</h2>
  <div class="meeting-box mt-6">
    <p class="text-sm uppercase tracking-wider text-(--w4-accent) font-semibold">{when}</p>
    <p class="text-white/70! mt-1">{title}</p>

    {topic && <p class="text-2xl font-bold text-white! leading-snug mt-3">{topic}</p>}
    {desc && <p class="text-white/70! mt-2">{desc}</p>}

    <div class="mt-5 text-white/85!">
      <p class="font-semibold text-white!">{venue}</p>
      {address && <p class="text-white/70! text-sm">{address}</p>}
    </div>

    <p class="mt-4 inline-block rounded-lg bg-emerald-500/10 border border-emerald-500/30 px-3 py-1.5 text-sm text-emerald-200!">
      Visitors welcome. No license needed.
    </p>

    <div class="flex flex-wrap gap-3 mt-5">
      {signupUrl && <a class={btn} href={signupUrl}>RSVP</a>}
      {calendarUrl && (
        <a class={btn} href={calendarUrl} target="_blank" rel="noopener noreferrer">Add to Calendar</a>
      )}
      {mapUrl && (
        <a class={btn} href={mapUrl} target="_blank" rel="noopener noreferrer">Directions</a>
      )}
      <a class={btn} href="/meetings/">Meeting Info</a>
    </div>
  </div>
</div>
