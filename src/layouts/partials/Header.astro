---
import Logo from "@/components/Logo.astro";
import ThemeSwitcher from "@/components/ThemeSwitcher.astro";
import config from "@/config/config.json";
import menu from "@/config/menu.json";
import { IoSearch } from "react-icons/io5";

export interface ChildNavigationLink {
  name: string;
  url: string;
}

export interface NavigationLink {
  name: string;
  url: string;
  hasChildren?: boolean;
  children?: ChildNavigationLink[];
}

const { main }: { main: NavigationLink[] } = menu;
const { navigation_button, settings } = config;
const { pathname } = Astro.url;

const isActive = (url: string) => pathname === url || pathname === `${url}/`;
const slug = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, "-");
---

<header class={`header z-30 ${settings.sticky_header && "sticky top-0"}`} transition:animate="none">
  <nav class="navbar container" aria-label="Main">
    <!-- logo -->
    <div class="order-0">
      <Logo />
    </div>

    <!-- mobile menu button (hidden on desktop) -->
    <button
      id="nav-toggle"
      type="button"
      class="nav-toggle order-2 flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-white/15 text-white lg:hidden"
      aria-controls="nav-menu"
      aria-expanded="false"
      aria-label="Menu"
    >
      <svg class="nav-icon-open h-5 fill-current" viewBox="0 0 20 20" aria-hidden="true">
        <path d="M0 3h20v2H0V3z m0 6h20v2H0V9z m0 6h20v2H0V0z"></path>
      </svg>
      <svg class="nav-icon-close h-5 fill-current" viewBox="0 0 20 20" aria-hidden="true">
        <polygon
          points="11 9 22 9 22 11 11 11 11 22 9 22 9 11 -2 11 -2 9 9 9 9 -2 11 -2"
          transform="rotate(45 10 10)"></polygon>
      </svg>
    </button>

    <!-- nav links: collapsible on mobile, always shown on desktop -->
    <ul
      id="nav-menu"
      class="navbar-nav order-3 hidden w-full border-t border-white/10 pt-3 pb-5 mt-3
             lg:order-1 lg:mt-0 lg:flex lg:w-auto lg:flex-1 lg:items-center lg:justify-center lg:gap-0.5 lg:border-0 lg:p-0 xl:gap-1"
    >
      {
        main.map((menu) => (
          <>
            {menu.hasChildren ? (
              <li class="nav-item nav-dropdown group relative">
                <button
                  type="button"
                  class:list={[
                    "nav-link nav-dropdown-toggle inline-flex items-center",
                    menu.children?.some(({ url }) => isActive(url)) && "active",
                  ]}
                  aria-expanded="false"
                  aria-controls={`submenu-${slug(menu.name)}`}
                >
                  {menu.name}
                  <svg class="h-4 w-4 fill-current ml-0.5 opacity-60 transition-transform" viewBox="0 0 20 20" aria-hidden="true">
                    <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z" />
                  </svg>
                </button>
                <ul
                  id={`submenu-${slug(menu.name)}`}
                  class="nav-dropdown-list hidden
                         lg:invisible lg:absolute lg:block lg:opacity-0
                         lg:group-hover:visible lg:group-hover:opacity-100"
                >
                  {menu.children?.map((child) => (
                    <li class="nav-dropdown-item">
                      <a
                        href={child.url}
                        class:list={["nav-dropdown-link block", isActive(child.url) && "active"]}
                        aria-current={isActive(child.url) ? "page" : undefined}
                      >
                        {child.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li class="nav-item">
                <a
                  href={menu.url}
                  class:list={["nav-link block", isActive(menu.url) && "active"]}
                  aria-current={isActive(menu.url) ? "page" : undefined}
                >
                  {menu.name}
                </a>
              </li>
            )}
          </>
        ))
      }

      <!-- mobile-only CTA inside the collapsible list -->
      {navigation_button.enable && (
        <li class="mt-4 lg:hidden">
          <a class="btn btn-primary w-full" href={navigation_button.link}>
            {navigation_button.label}
          </a>
        </li>
      )}
    </ul>

    <!-- right-side actions -->
    <div class="order-1 ml-auto flex items-center gap-3 lg:order-2 lg:ml-0">
      {settings.search && (
        <button
          class="border-border text-text-dark hover:text-primary dark:border-darkmode-border mr-5 inline-block border-r pr-5 text-xl dark:text-white dark:hover:text-darkmode-primary"
          aria-label="search"
          data-search-trigger
        >
          <IoSearch />
        </button>
      )}
      <ThemeSwitcher />
      <!-- desktop CTA (visible on lg+) -->
      {navigation_button.enable && (
        <a
          class="btn btn-primary btn-sm hidden lg:inline-flex"
          href={navigation_button.link}
        >
          {/* Short label on small desktops (lg–xl) so the nav fits on one row */}
          <span class="xl:hidden">{navigation_button.label.split(" ")[0]}</span>
          <span class="hidden xl:inline">{navigation_button.label}</span>
        </a>
      )}
    </div>
  </nav>
</header>

<script>
  // Menu behaviour (disclosure pattern):
  // - The mobile menu button and each dropdown button toggle aria-expanded.
  //   CSS in safe.css shows the menu / dropdown from that attribute.
  // - Mouse users still get hover dropdowns on desktop (lg:group-hover).
  // - Escape closes an open dropdown (or the mobile menu) and returns focus to
  //   its button; moving focus or clicking outside a dropdown closes it.
  // The header is replaced on every View Transition, so element listeners are
  // bound now (this module runs once the DOM is parsed) and again after each
  // swap. Not astro:page-load: on first visit that waits for every image and
  // widget to finish loading, leaving the menu dead until then. Document
  // listeners are bound once.

  const desktop = window.matchMedia("(min-width: 1024px)");

  const dropdownButtons = () =>
    document.querySelectorAll<HTMLButtonElement>(".nav-dropdown-toggle");

  const setExpanded = (btn: HTMLElement, open: boolean) =>
    btn.setAttribute("aria-expanded", String(open));

  const closeDropdowns = (except?: Element) =>
    dropdownButtons().forEach((btn) => {
      if (btn !== except) setExpanded(btn, false);
    });

  const setMenuOpen = (open: boolean) => {
    const toggle = document.getElementById("nav-toggle");
    const menu = document.getElementById("nav-menu");
    if (!toggle || !menu) return;
    setExpanded(toggle, open);
    menu.classList.toggle("hidden", !open);
  };

  const bindMenu = () => {
    const navToggle = document.getElementById("nav-toggle");
    if (!navToggle || navToggle.dataset.bound) return;
    navToggle.dataset.bound = "true";

    navToggle.addEventListener("click", (e) => {
      const btn = e.currentTarget as HTMLElement;
      setMenuOpen(btn.getAttribute("aria-expanded") !== "true");
    });

    dropdownButtons().forEach((btn) => {
      btn.addEventListener("click", () => {
        const open = btn.getAttribute("aria-expanded") !== "true";
        closeDropdowns(btn);
        setExpanded(btn, open);
      });

      const item = btn.closest(".nav-dropdown");
      // Close when focus leaves the dropdown (e.g. tabbing past the last link)
      item?.addEventListener("focusout", (e) => {
        const next = (e as FocusEvent).relatedTarget as Node | null;
        if (next && !item.contains(next)) setExpanded(btn, false);
      });
      // Mouse users: don't leave a clicked-open dropdown stuck after hovering away
      item?.addEventListener("mouseleave", () => {
        if (desktop.matches && !item.contains(document.activeElement)) setExpanded(btn, false);
      });
    });
  };

  bindMenu();
  document.addEventListener("astro:after-swap", bindMenu);

  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    const openBtn = [...dropdownButtons()].find(
      (b) => b.getAttribute("aria-expanded") === "true"
    );
    if (openBtn) {
      setExpanded(openBtn, false);
      openBtn.focus();
      return;
    }
    const toggle = document.getElementById("nav-toggle");
    if (toggle?.getAttribute("aria-expanded") === "true") {
      setMenuOpen(false);
      toggle.focus();
    }
  });

  // Click or tap outside any dropdown closes it
  document.addEventListener("click", (e) => {
    if (!(e.target as Element).closest?.(".nav-dropdown")) closeDropdowns();
  });

  // Crossing the desktop breakpoint resets everything
  desktop.addEventListener("change", () => {
    closeDropdowns();
    setMenuOpen(false);
  });
</script>
