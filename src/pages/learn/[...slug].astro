---
import Base from "@/layouts/Base.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const pages = await getCollection("learn");
  return pages.map((page) => ({
    params: { slug: page.id },
    props: { page },
  }));
}

interface Props {
  page: CollectionEntry<"learn">;
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<Base
  title={page.data.title}
  meta_title={`KARC - ${page.data.title}`}
  description={page.data.description ?? `Learn about ${page.data.title.toLowerCase()} from the Kingsport Amateur Radio Club.`}
>
  <section class="hero-heroimg relative">
    <div aria-hidden="true" class="absolute inset-0 -z-10">
      <div class="w-full h-full bg-linear-to-b from-black/55 via-black/60 to-black/75"></div>
    </div>
    <div class="container mx-auto px-6 py-16 text-center">
      <h1 class="text-4xl font-extrabold mb-4">{page.data.title}</h1>
      {page.data.description && (
        <p class="text-lg text-white/80 max-w-2xl mx-auto">{page.data.description}</p>
      )}
    </div>
  </section>

  <section class="section-md">
    <article class="max-w-[780px] mx-auto px-6">
      <div class="w4-card p-6 md:p-10">
        <div class="prose prose-invert prose-base md:prose-lg max-w-none
          prose-headings:text-white prose-headings:font-bold
          prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4
          prose-p:text-white/80 prose-p:leading-relaxed
          prose-ul:text-white/80 prose-li:text-white/80
          prose-strong:text-white
          prose-a:text-(--w4-accent) prose-a:underline prose-a:underline-offset-4
        ">
          <Content />
        </div>
      </div>

      <div class="w4-card p-6 md:p-8 mt-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div class="space-y-1">
          <h2 class="text-xl font-bold text-white">Ready to learn more?</h2>
          <p class="text-sm text-white/75">Come to a club meeting — no license needed, and everyone is welcome.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a class="btn btn-primary" href="/meetings/">Club Meetings</a>
          <a class="btn btn-outline" href="/contact/">Get in Touch</a>
        </div>
      </div>
    </article>
  </section>
</Base>