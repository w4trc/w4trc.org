---
import Base from "@/layouts/Base.astro";
import PageHero from "@/components/PageHero.astro";
import { getCollection, getEntry, render } from "astro:content";

export const prerender = true;

export async function getStaticPaths() {
  const officers = await getCollection("officers");
  return officers.map((officer) => ({ params: { slug: officer.id } }));
}

const { slug } = Astro.params;

let officer;
try {
  officer = await getEntry("officers", slug!);
} catch {
  return Astro.redirect("/404");
}

if (!officer) return Astro.redirect("/404");

const { data } = officer;
const { Content } = await render(officer);
---

<Base
  title={`${data.position}: ${data.title}`}
  meta_title={`KARC - ${data.position}: ${data.title}`}
  description={`${data.title}${data.callsign ? ` (${data.callsign})` : ""}, ${data.position} of the Kingsport Amateur Radio Club (W4TRC) in Kingsport, TN.`}
  image={data.photo}
>
  <PageHero
    back={{ href: "/about/#club-officers", label: "All officers" }}
    eyebrow={data.position}
    title={data.title}
  >
    {data.photo && (
      <img
        slot="media"
        src={data.photo}
        alt={data.photo_alt || data.title}
        class="mx-auto mb-6 h-32 w-32 rounded-full object-cover shadow-[0_0_0_6px_rgba(255,255,255,.06),0_20px_50px_-10px_rgba(0,0,0,.7)]"
        loading="eager"
        decoding="async"
      />
    )}
    {data.callsign && (
      <div class="mt-4 inline-flex rounded-full border border-white/15 bg-white/5 px-4 py-1.5 font-mono text-sm font-medium tracking-widest text-(--w4-accent)">
        {data.callsign}
      </div>
    )}
  </PageHero>

  {officer.body?.trim() && (
    <section class="section-md">
      <div class="max-w-[760px] mx-auto px-6">
        <div class="content">
          <Content />
        </div>
      </div>
    </section>
  )}
</Base>
