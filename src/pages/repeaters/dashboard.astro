---
import PageHero from "@/components/PageHero.astro";
import Base from "@/layouts/Base.astro";
import TowerDashboard from '../../layouts/components/TowerDashboard.astro';
const heroImage = "/images/IMG_2781.jpg";
---
<Base
  title="Repeater Dashboard"
  meta_title="KARC - Repeater Dashboard"
  description="Live status, stats, and activity for the Kingsport Amateur Radio Club (W4TRC) repeaters serving Kingsport and the Tri-Cities."
  image="/images/KARC-SEOImage.png"
>

  <PageHero
    back={{ href: "/repeaters/", label: "Repeaters" }}
    eyebrow="Live from the tower"
    title="Tower Site Dashboard"
    subtitle="Information from our tower monitoring systems, including live stats, weather data, and more."
    image={heroImage}
  />

<TowerDashboard />
</Base>