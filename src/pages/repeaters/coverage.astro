---
import ImageMod from "@/components/ImageMod.astro";
import Base from "@/layouts/Base.astro";

// The map itself lives in the coverage Worker; this page only embeds it.
const APP = "https://coverage.w4trc.org";
const heroImage = "/images/IMG_2781.jpg";
---

<Base
  title="Repeater Coverage Map"
  meta_title="KARC - Repeater Coverage Map"
  description="Predicted coverage and real-world signal reports for the W4TRC repeaters."
  image="/images/KARC-SEOImage.png"
>
  <!-- HERO -->
  <section class="hero-heroimg relative">
    <div aria-hidden="true" class="absolute inset-0 -z-10">
      <ImageMod
        src={heroImage}
        alt="Club radio gear"
        width={1600}
        height={600}
        format="webp"
        class="w-full h-full object-cover opacity-50"
      />
      <div class="absolute inset-0 bg-linear-to-b from-black/60 via-black/55 to-black/70"></div>
    </div>

    <div class="container mx-auto px-6 py-16 text-center">
      <p class="text-sm uppercase tracking-[0.14em] text-(--w4-accent) mb-2">W4TRC Repeaters</p>
      <h1 class="text-4xl font-extrabold mb-4">Repeater Coverage Map</h1>
      <p class="text-lg text-white/70 max-w-2xl mx-auto">
        See where you can expect to reach the W4TRC repeater. The shaded area is a computer prediction, and the
        hexagons are signal reports from real people. If you have been somewhere on the map, add a report of your own.
      </p>
      <a
        href={APP}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 text-(--w4-accent) font-semibold mt-5 hover:underline underline-offset-4"
      >
        Open the map full screen (best on a phone)
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- MAP -->
  <section class="section-md">
    <div class="max-w-[1400px] mx-auto px-4 md:px-6">
      <iframe
        id="coverage-frame"
        src={`${APP}/?embed=1`}
        title="W4TRC repeater coverage map"
        allow="geolocation"
        loading="lazy"
        class="w4-card p-0 overflow-hidden"
        style="width:100%; height:85vh; min-height:640px; border:0;"></iframe>
      <p class="text-sm text-white/60 mt-4">
        Back to <a class="underline" href="/repeaters/">Repeaters &amp; Nets</a>.
      </p>
    </div>
  </section>
</Base>

<script is:inline define:vars={{ APP }}>
  // The map reports its content height so the iframe fits without a second scrollbar.
  // If the message never arrives, the fixed height in the style attribute stays in effect.
  const frame = document.getElementById("coverage-frame");

  window.addEventListener("message", (event) => {
    if (event.origin !== APP || !event.data || event.data.type !== "coverage:height") return;
    const height = Number(event.data.height);
    if (height > 300 && height < 6000) {
      frame.style.minHeight = "0";
      frame.style.height = height + "px";
    }
  });

  // Match the site's light/dark toggle (ThemeSwitcher puts a "dark" class on <html>).
  let currentTheme = "";
  const syncTheme = () => {
    const theme = document.documentElement.classList.contains("dark") ? "dark" : "light";
    if (theme === currentTheme) return;
    currentTheme = theme;
    frame.src = APP + "/?embed=1&theme=" + theme;
  };
  syncTheme();
  new MutationObserver(syncTheme).observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
</script>
