---
import PageHero from "@/components/PageHero.astro";
import Base from "@/layouts/Base.astro";
---

<Base
  title="Member Articles & Bios"
  meta_title="KARC - Member Articles and Bios"
  description="Articles from the Kingsport Amateur Radio Club: member spotlights, project write-ups, and how-to guides for hams of every experience level."
>
  <PageHero
    eyebrow="Resources"
    title="Member Articles & Bios"
    subtitle="Feature write-ups from members: station builds, how-to guides, and bios."
    image="/images/patrick-tomasso-Oaqk7qqNh_c-unsplash.jpg"
  />

  <section class="section-md">
    <div class="max-w-[1000px] mx-auto px-6 space-y-8">
      <article class="w4-card p-6 space-y-2">
        <h2 class="text-xl font-bold text-white mb-2">Member Articles</h2>
        <ul class="list-disc list-inside text-sm text-white/80 space-y-2">
          <li><a class="underline" href="/files/member-articles/AM-ON-FM-THEN-NOW-Final.pdf" >"“AM ON FM” ---- THEN & NOW" by George DeVault (W3KPT)</a></li>
          <li><a class="underline" href="/files/member-articles/Hiking-Through.pdf" >"Hiking Through" by Larry Dale (KD4FTN)</a></li>
          <li><a class="underline" href="/files/member-articles/QRP-In-The-Park.pdf" >QRP in the Park by John Williams (KJ4ZFK)</a></li>
          <li><a class="underline" href="/files/member-articles/Quest-for-Goat.pdf" >Quest for GOAT by John Williams (KJ4ZFK)</a></li>
          <li><a class="underline" href="/files/member-articles/Mike-Jackson-Article.pdf" >How Illness Brought Me to Ham Radio by Mike Jackson (W4MKJI)</a></li>
        </ul>
      </article>

      <article class="w4-card p-6 space-y-2">
        <h2 class="text-xl font-bold text-white mb-2">Member Bios</h2>
        <ul class="list-disc list-inside text-sm text-white/80 space-y-2 mt-2">
          <li><a class="underline" href="/files/bios/Bob-Biography.pdf" >Robert "Bob" David Watts </a></li>
          <li><a class="underline" href="/files/bios/David-Stevens-Bio.pdf" >David Stevens (WB4DES)</a></li>
          <li><a class="underline" href="/files/bios/George-DeVault.pdf" >George DeVault (W3KPT)</a></li>
          <li><a class="underline" href="/files/bios/K4DR-bio.pdf" >David A. Rotenberry (K4DR)</a></li>
          <li><a class="underline" href="/files/bios/Ken-Klotz.pdf" >Ken Klotz (W4IJK)</a></li>
          <li><a class="underline" href="/files/bios/Mark-DeBord-BIO.pdf" >Mark-DeBord (KA4ICK)</a></li>
          <li><a class="underline" href="/files/bios/Mike-Betty-Bio.pdf" >Mike (W4MKJI) and Betty (KI4PWN) Jackson</a></li>
          <li><a class="underline" href="/files/bios/Neil-Weber-Bio.pdf" >Neil Weber (KM4NWH)</a></li>
          <li><a class="underline" href="/files/bios/Rick-Johnson-Bio.pdf" >Rick Johnson (WB4RLJ)</a></li>
          <li><a class="underline" href="/files/bios/Erik-McCord-Bio.pdf" >Erik McCord (WX4ET)</a></li>
        </ul>
      </article>
    </div>
  </section>
</Base>
