---
import PageHero from "@/components/PageHero.astro";
import Base from "@/layouts/Base.astro";
---

<Base
  title="Documents & Downloads"
  meta_title="KARC - Documents & Downloads"
  description="Grab club forms, reference sheets, and other frequently requested documents."
>
  <PageHero
    eyebrow="Resources"
    title="Documents & Downloads"
    subtitle="Club forms, reference sheets, and other frequently requested documents."
    image="/images/wesley-tingey-snNHKZ-mGfE-unsplash.jpg"
  />

  <section class="section-md">
    <div class="max-w-[1000px] mx-auto px-6 space-y-8">
      <article class="w4-card p-6 space-y-2">
        <h2 class="text-xl font-bold text-white mb-2">Club Forms</h2>
        <ul class="list-disc list-inside text-sm text-white/80 space-y-2">
          <li><a class="underline" href="/files/KARC-Constitution-By-Laws_20180412.pdf">Club Constitution and By-Laws (Revision dated 12 April 2018)</a></li>
         
        </ul>
      </article>

      <article class="w4-card p-6 space-y-2">
        <h2 class="text-xl font-bold text-white mb-2">Club Presentations</h2>
        <ul class="list-disc list-inside text-sm text-white/80 space-y-2">
          <li><a class="underline" href="/files/presentations/KARC Presentation - Fox Hunting.pdf">2/13/26 - Fox Hunting - N4JHC</a></li>
          <li><a class="underline" href="/files/presentations/KARC Presentation - Portable Digital.pdf">1/8/26 - Portable Digital Modes - N4JHC</a></li>
        </ul>
      </article>

      <article class="w4-card p-6 space-y-2">
        <h2 class="text-xl font-bold text-white mb-2">Operating Resources</h2>
        <ul class="list-disc list-inside text-sm text-white/80 space-y-2">
          <li><a class="underline" href="/files/KARC-Net-Script-20190410.pdf">Net script</a></li>
          <li><a class="underline" href="/files/KARC-Quick-Reference.pdf">Quick reference card (repeaters, net, meeting — 5.5×4.25" postcard)</a></li>
          <li><a class="underline" href="/files/KARC-Welcome-Card.pdf">Welcome card for newcomers (what is ham radio, how to get licensed — 5.5×4.25" postcard)</a></li>
          <li><a class="underline" href="/files/KARC-New-Ham-Card.pdf">New ham checklist with repeater programming guide (5.5×4.25" postcard)</a></li>
          <li><a class="underline" href="/files/KARC-Congrats-Card.pdf">Congratulations card for new licensees — what to do right after passing (5.5×4.25" postcard)</a></li>
        </ul>
      </article>

      <article class="w4-card p-6 space-y-2">
        <h2 class="text-xl font-bold text-white mb-2">Meeting Resources</h2>
        <ul class="list-disc list-inside text-sm text-white/80 space-y-2">
          <li><a class="underline" href="/files/KARC Sign In Sheet.pdf">Event sign-in sheet</a></li>
        </ul>
      </article>
    </div>
  </section>
</Base>
