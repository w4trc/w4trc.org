---
import PageHero from "@/components/PageHero.astro";
import Base from "@/layouts/Base.astro";
import newsletters from "@/data/newsletters.json";

const issues = [...newsletters].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);

const toDate = (iso: string) => new Date(iso + (iso.includes("T") ? "" : "T00:00:00"));
const month = (iso: string, style: "long" | "short") =>
  toDate(iso).toLocaleDateString("en-US", { month: style });

const latest = issues[0];
const years = [...new Set(issues.map((i) => i.date.slice(0, 4)))];
const byYear = years.map((year) => ({
  year,
  items: issues.filter((i) => i.date.startsWith(year)),
}));
---

<Base
  title="Zero-Beat"
  meta_title="KARC - Zero-Beat"
  description="The Zero-Beat newsletter archive from the Kingsport Amateur Radio Club, with quick links to recent issues and club news."
>
  <PageHero
    eyebrow="Club newsletter"
    title="Zero-Beat"
    image="/images/roman-kraft-_Zua2hyvTBk-unsplash.jpg"
  >
    <p>Catch up on recent issues or download past editions of the Zero-Beat newsletter.</p>
    <p class="hero-byline">Current editor: Erik WX4ET</p>
  </PageHero>

  <section class="section-md">
    <div class="mx-auto max-w-[1000px] px-6 space-y-14">
      {latest?.link && (
        <a
          href={latest.link}
          target="_blank"
          rel="noreferrer"
          class="w4-card w4-card-link group relative flex flex-col items-start gap-6 overflow-hidden p-8 sm:flex-row sm:items-center sm:justify-between"
        >
          <div class="flex items-center gap-6">
            <div class="flex h-20 w-16 shrink-0 flex-col items-center justify-center rounded-lg border border-white/15 bg-linear-to-b from-white/10 to-white/[.02] font-mono text-[10px] uppercase tracking-widest text-white/60 shadow-[0_12px_24px_-12px_rgba(0,0,0,.8)]">
              <span class="text-(--w4-accent)">PDF</span>
            </div>
            <div>
              <div class="eyebrow mb-1">Latest issue</div>
              <h2 class="font-secondary text-2xl font-bold text-white sm:text-3xl">
                {month(latest.date, "long")} {latest.date.slice(0, 4)}
              </h2>
            </div>
          </div>
          <span class="btn btn-primary btn-sm">
            Read it <span aria-hidden="true">→</span>
          </span>
        </a>
      )}

      <div class="space-y-10">
        {byYear.map(({ year, items }) => (
          <section class="py-0! grid gap-4 md:grid-cols-[120px_minmax(0,1fr)]">
            <h2 class="font-secondary text-3xl font-bold text-white">{year}</h2>
            <ul class="grid grid-cols-3 gap-2 sm:grid-cols-4 lg:grid-cols-6">
              {items.map((issue) => (
                <li>
                  {issue.link ? (
                    <a
                      href={issue.link}
                      target="_blank"
                      rel="noreferrer"
                      class="flex flex-col rounded-xl border border-white/10 bg-white/[.03] px-3 py-3 transition hover:-translate-y-0.5 hover:border-(--w4-accent) hover:bg-white/[.06]"
                    >
                      <span class="font-medium text-white">{month(issue.date, "short")}<span class="sr-only"> {year} Zero-Beat</span></span>
                      <span class="font-mono text-[11px] text-white/60">PDF <span aria-hidden="true">↓</span></span>
                    </a>
                  ) : (
                    <span class="flex flex-col rounded-xl border border-dashed border-white/10 px-3 py-3 text-white/55">
                      {month(issue.date, "short")}
                      <span class="font-mono text-[11px]">missing</span>
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </section>
</Base>
