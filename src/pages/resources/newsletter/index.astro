---
import PageHero from "@/components/PageHero.astro";
import Base from "@/layouts/Base.astro";
import newsletters from "@/data/newsletters.json";

const issues = [...newsletters].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);

const fmtDate = (iso: string) =>
  new Date(iso + (iso.includes("T") ? "" : "T00:00:00")).toLocaleDateString("en-US", {
    month: "long",
    year: "numeric",
  });
---

<Base
  title="Zero-Beat"
  meta_title="KARC - Zero-Beat"
  description="The Zero-Beat newsletter archive from the Kingsport Amateur Radio Club, with quick links to recent issues and club news."
>
  <PageHero
    eyebrow="Club newsletter"
    title="Zero-Beat"
    image="/images/roman-kraft-_Zua2hyvTBk-unsplash.jpg"
  >
    <p>Catch up on recent issues or download past editions of the Zero-Beat newsletter.</p>
    <p class="hero-byline">Current editor: Erik WX4ET</p>
  </PageHero>

  <section class="section-md">
    <div class="max-w-[1100px] mx-auto px-6">
      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {issues.map((issue) => (
          <article class="w4-card p-6 flex flex-col gap-3">
            <div class="flex items-start justify-between gap-3">
              <div>
                <h2 class="text-xl font-bold text-white leading-snug">
                  {issue.title ?? fmtDate(issue.date)}
                </h2>
              </div>
              
            </div>
            {issue.summary && <p class="text-sm text-white/75">{issue.summary}</p>}
            {issue.link ? (
              <a class="button inline-flex items-center justify-center px-3 py-2 text-sm font-semibold mt-auto underline" href={issue.link} target="_blank" rel="noreferrer">
                Download PDF
              </a>
            ) : (
              <p class="text-xs text-white/50 mt-auto">Add a link for this issue in newsletters.json</p>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
