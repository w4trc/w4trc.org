---
import PageHero from "@/components/PageHero.astro";
import Base from "@/layouts/Base.astro";
---

<Base
  title="License Testing"
  meta_title="KARC - License Testing"
  description="Amateur radio license testing in Kingsport, TN: upcoming exam sessions, what to bring, and study resources for Technician, General, and Extra."
>
  <script slot="head" is:inline>
    gtag("event", "conversion", { send_to: "AW-17728556033/wx9hCKTcu9MbEIGY0YVC" });
  </script>

  <PageHero
    eyebrow="Resources"
    title="License Testing"
    subtitle="VE session details and prep resources for new and upgrading hams."
    image="/images/license-testing-header.png"
  />

  <section class="section-md">
    <div class="max-w-[1000px] mx-auto px-6 space-y-8">
      <article class="w4-card p-6 space-y-2">
        <h2 class="text-xl font-bold text-white mb-2">Testing on Demand</h2>
        <p class="text-sm text-white/75 mb-2">
          We do testing on demand for individuals or small groups by appointment. Please
          <a class="underline" href="/contact">contact us</a> to schedule a session. We regularly hold testing sessions before our monthly club meetings but are able to test at any time.
        </p>
      </article>

      <article class="w4-card p-6 space-y-2">
        <h2 class="text-xl font-bold text-white mb-2">What to Bring</h2>
        <ul class="list-disc list-inside text-sm text-white/80 space-y-2">
          <li>Government-issued photo ID</li>
          <li>FRN (FCC Registration Number)</li>
          <li>Testing fee (cash)</li>
          <li>Two pencils, simple calculator (no memory storage)</li>
          <li>Copy of current license and CSCEs if upgrading</li>
        </ul>
      </article>

      <article class="w4-card p-6 space-y-2">
        <h2 class="text-xl font-bold text-white mb-2">Study Resources</h2>
        <ul class="list-disc list-inside text-sm text-white/80 space-y-2">
          <li><a class="underline" href="https://hamstudy.org" target="_blank" rel="noreferrer">HamStudy.org</a></li>
          <li><a class="underline" href="https://www.arrl.org/getting-licensed" target="_blank" rel="noreferrer">ARRL Getting Licensed</a></li>
          <li><a class="underline" href="https://hamradioprep.com/" target="_blank" rel="noreferrer">Ham Radio Prep</a></li>
          <li><a class="underline" href="https://www.qrz.com/hamtest/" target="_blank" rel="noreferrer">QRZ Practice Tests</a></li>
        </ul>
      </article>
    </div>
  </section>
</Base>
