---
import ImageMod from "@/components/ImageMod.astro";
import PageHero from "@/components/PageHero.astro";
import Base from "@/layouts/Base.astro";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import type { ImageMetadata } from "astro";

export async function getStaticPaths() {
  const all = await getCollection("posts", ({ data }) => !data.draft);
  return all.map((p) => ({
    params: { slug: p.id.replace(/\/index$/, "") },
    props: { post: p },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;

const fmtDate = (iso: string) =>
  new Date(iso + "T00:00:00").toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
const byline = [fmtDate(d.date), d.author].filter(Boolean).join(" · ");

// Collect gallery images for this post's gallery/ subfolder
const allGalleryModules = import.meta.glob<{ default: ImageMetadata }>(
  "../../content/posts/**/gallery/*.{jpg,jpeg,png,webp,gif,JPG,JPEG,PNG}",
  { eager: true }
);

const postFolder = post.id.replace(/\/index$/, "");
const galleryImages = Object.entries(allGalleryModules)
  .filter(([path]) => path.includes(`/${postFolder}/gallery/`))
  .map(([_, mod]) => mod.default);
---

<Base
  title={d.title}
  meta_title={`KARC - ${d.title}`}
  ogType="article"
  description={d.summary}
  image={d.image ?? "/images/KARC-SEOImage.png"}
>
  <PageHero
    back={{ href: "/posts/", label: "All posts" }}
    eyebrow={byline}
    title={d.title}
    subtitle={d.summary}
  >
    {d.tags && d.tags.length > 0 && (
      <div class="mt-6 flex flex-wrap justify-center gap-2">
        {d.tags.map((tag) => (
          <span class="rounded-full border border-white/15 bg-white/5 px-3 py-1 font-mono text-[11px] uppercase tracking-wider text-white/70">
            {tag.replace(/-/g, " ")}
          </span>
        ))}
      </div>
    )}
  </PageHero>

  <section class="section-md pt-0!">
    {d.image && (
      <div class="mx-auto -mt-6 mb-12 max-w-[1000px] px-6">
        <ImageMod
          src={d.image}
          alt={d.title}
          width={1600}
          widths={[480, 800, 1200, 1600]}
          sizes="(min-width: 1000px) 952px, calc(100vw - 48px)"
          format="webp"
          class="aspect-[2/1] w-full rounded-[var(--w4-radius)] border border-white/10 object-cover shadow-[0_30px_60px_-20px_rgba(0,0,0,.8)]"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    )}

    <div class:list={["mx-auto max-w-[720px] px-6 space-y-12", !d.image && "pt-12"]}>
      <article class="content post-body">
        <Content />
      </article>

      {galleryImages.length > 0 && (
        <div class="space-y-4 border-t border-white/10 pt-10">
          <div class="eyebrow">Gallery</div>
          <h2 class="section-title before:hidden text-2xl!">Photos</h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
            {galleryImages.map((img, i) => (
              <button
                class="gallery-thumb overflow-hidden rounded-lg aspect-square cursor-zoom-in focus:outline-none focus:ring-2 focus:ring-[var(--w4-accent)]"
                data-index={i}
                aria-label={`Open photo ${i + 1}`}
              >
                <Image
                  src={img}
                  alt={`${d.title} photo ${i + 1}`}
                  width={400}
                  height={400}
                  class="w-full h-full object-cover hover:scale-105 transition-transform duration-200"
                  loading="lazy"
                />
              </button>
            ))}
          </div>
        </div>
      )}

      <div class="border-t border-white/10 pt-8">
        <a class="btn-ghost" href="/posts/">
          <span aria-hidden="true">←</span> All posts
        </a>
      </div>

    </div>
  </section>

<style>
  .post-body {
    font-size: 1.075rem;
    line-height: 1.8;
  }
</style>

  {galleryImages.length > 0 && (
    <>
      <!-- Lightbox -->
      <div
        id="lightbox"
        class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90"
        role="dialog"
        aria-modal="true"
        aria-label="Photo lightbox"
      >
        <button
          id="lb-close"
          class="absolute top-4 right-4 text-white/70 hover:text-white text-3xl leading-none"
          aria-label="Close"
        >
          ×
        </button>
        <button
          id="lb-prev"
          class="absolute left-4 text-white/70 hover:text-white text-4xl leading-none px-2"
          aria-label="Previous photo"
        >
          ‹
        </button>
        <img
          id="lb-img"
          src=""
          alt=""
          class="max-h-[90vh] max-w-[90vw] object-contain rounded-lg"
        />
        <button
          id="lb-next"
          class="absolute right-4 text-white/70 hover:text-white text-4xl leading-none px-2"
          aria-label="Next photo"
        >
          ›
        </button>
        <p id="lb-counter" class="absolute bottom-4 text-white/50 text-sm tabular-nums"></p>
      </div>

      <script define:vars={{ srcs: galleryImages.map((img) => img.src) }}>
        const lb = document.getElementById("lightbox");
        const lbImg = document.getElementById("lb-img");
        const lbCounter = document.getElementById("lb-counter");
        let current = 0;

        function show(i) {
          current = (i + srcs.length) % srcs.length;
          lbImg.src = srcs[current];
          lbImg.alt = `Photo ${current + 1}`;
          lbCounter.textContent = `${current + 1} / ${srcs.length}`;
        }

        function open(i) {
          show(i);
          lb.classList.remove("hidden");
          lb.classList.add("flex");
          document.body.style.overflow = "hidden";
        }

        function close() {
          lb.classList.add("hidden");
          lb.classList.remove("flex");
          document.body.style.overflow = "";
        }

        document.querySelectorAll(".gallery-thumb").forEach((btn) => {
          btn.addEventListener("click", () => open(Number(btn.dataset.index)));
        });

        document.getElementById("lb-close").addEventListener("click", close);
        document.getElementById("lb-prev").addEventListener("click", () => show(current - 1));
        document.getElementById("lb-next").addEventListener("click", () => show(current + 1));

        lb.addEventListener("click", (e) => { if (e.target === lb) close(); });

        document.addEventListener("keydown", (e) => {
          if (lb.classList.contains("hidden")) return;
          if (e.key === "Escape") close();
          if (e.key === "ArrowLeft") show(current - 1);
          if (e.key === "ArrowRight") show(current + 1);
        });
      </script>
    </>
  )}
</Base>
