---
import PageHero from "@/components/PageHero.astro";
import Base from "@/layouts/Base.astro";
import { getCollection } from "astro:content";
import PostCard from "@/layouts/components/PostCard.astro";

const all = await getCollection("posts", ({ data }) => !data.draft);

const posts = all.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

---

<Base
  title="Posts"
  meta_title="KARC - Club Posts"
  description="Event recaps, news, and updates from the Kingsport Amateur Radio Club."
>
  <PageHero
    eyebrow="News & recaps"
    title="Club Posts"
    subtitle="Event recaps, news, and updates from W4TRC."
  />

  <section class="section-md">
    <div class="max-w-[1200px] mx-auto px-6 space-y-8">
      {posts.length === 0 ? (
        <div class="w4-card p-8 text-center">
          <p class="text-white/60">No posts yet. Check back soon!</p>
        </div>
      ) : (
        <>
          <PostCard post={posts[0]} featured />
          {posts.length > 1 && (
            <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
              {posts.slice(1).map((post) => <PostCard post={post} />)}
            </div>
          )}
        </>
      )}
    </div>
  </section>
</Base>
