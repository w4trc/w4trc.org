---
import PageHero from "@/components/PageHero.astro";
import Base from "@/layouts/Base.astro";
import { photoAlt, photoUrl } from "@/lib/gallery";
import { getCollection, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const albums = await getCollection("albums");
  return albums.map((album) => ({
    params: { album: album.id },
    props: { album },
  }));
}

const { album } = Astro.props as { album: CollectionEntry<"albums"> };
const { title, date, description, photos } = album.data;
const cover = photos.find((p) => p.file === album.data.cover) ?? photos[0];

const prettyDate = new Date(date + "T00:00:00").toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const items = photos.map((p, i) => ({
  ...p,
  thumb: photoUrl(album.id, p.file, "t"),
  full: photoUrl(album.id, p.file, "d"),
  alt: photoAlt(p, title, i),
}));
---

<Base
  title={title}
  meta_title={`${title} - KARC Photo Gallery`}
  description={description ??
    `${photos.length} photos from ${title}, Kingsport Amateur Radio Club.`}
  image={photoUrl(album.id, cover.file, "d")}
>
  <PageHero
    eyebrow={`${prettyDate} · ${photos.length} photos`}
    title={title}
    subtitle={description}
    image={photoUrl(album.id, cover.file, "d")}
    back={{ href: "/gallery/", label: "All albums" }}
  />

  <section class="section-md">
    <div class="max-w-[1200px] mx-auto px-6">
      <ul
        class="grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-4"
        data-gallery
      >
        {
          items.map((p, i) => (
            <li>
              <figure class="m-0">
                <a
                  href={p.full}
                  class="block aspect-[4/3] overflow-hidden rounded-lg bg-[#0b111d] focus:outline-none focus-visible:ring-2 focus-visible:ring-(--w4-accent)"
                  data-index={i}
                  data-caption={p.caption ?? ""}
                  data-width={p.width}
                  data-height={p.height}
                >
                  <img
                    src={p.thumb}
                    alt={p.alt}
                    width={p.width}
                    height={p.height}
                    loading={i < 8 ? "eager" : "lazy"}
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-300 hover:scale-[1.04]"
                  />
                </a>
                {p.caption && (
                  <figcaption class="px-1 pt-1.5 text-xs text-white/65">
                    {p.caption}
                  </figcaption>
                )}
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <dialog class="lightbox" aria-label="Photo viewer">
    <figure>
      <img alt="" />
      <figcaption>
        <span class="lb-caption"></span>
        <span class="lb-count font-mono"></span>
      </figcaption>
    </figure>
    <button
      type="button"
      class="lb-btn lb-close"
      aria-label="Close"
      data-action="close"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true"
        ><path d="M6 6l12 12M18 6L6 18"></path></svg
      >
    </button>
    <button
      type="button"
      class="lb-btn lb-prev"
      aria-label="Previous photo"
      data-action="prev"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true"
        ><path d="M15 5l-7 7 7 7"></path></svg
      >
    </button>
    <button
      type="button"
      class="lb-btn lb-next"
      aria-label="Next photo"
      data-action="next"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true"
        ><path d="M9 5l7 7-7 7"></path></svg
      >
    </button>
  </dialog>
</Base>

<script>
  // The site uses Astro's ClientRouter, so page scripts only run on the first
  // full load. astro:page-load fires then and after every client-side
  // navigation, which is when a gallery page may have just been swapped in.
  document.addEventListener("astro:page-load", () => {
    const dialog = document.querySelector<HTMLDialogElement>("dialog.lightbox");
    if (dialog) initLightbox(dialog);
  });

  function initLightbox(dialog: HTMLDialogElement) {
    const links = [
      ...document.querySelectorAll<HTMLAnchorElement>(
        "[data-gallery] a[data-index]",
      ),
    ];
    const img = dialog.querySelector("img")!;
    const caption = dialog.querySelector<HTMLElement>(".lb-caption")!;
    const count = dialog.querySelector<HTMLElement>(".lb-count")!;
    let current = 0;

    const show = (i: number) => {
      current = (i + links.length) % links.length;
      const link = links[current];
      const thumb = link.querySelector("img")!;
      img.src = link.href;
      img.alt = thumb.alt;
      img.width = Number(link.dataset.width);
      img.height = Number(link.dataset.height);
      caption.textContent = link.dataset.caption ?? "";
      count.textContent = `${current + 1} / ${links.length}`;
      // Warm the cache for the neighbours so arrowing through feels instant.
      for (const n of [current + 1, current - 1]) {
        new Image().src = links[(n + links.length) % links.length].href;
      }
    };

    links.forEach((link, i) =>
      link.addEventListener("click", (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();
        show(i);
        dialog.showModal();
      }),
    );

    dialog.addEventListener("click", (e) => {
      const action = (e.target as Element).closest<HTMLElement>("[data-action]")
        ?.dataset.action;
      if (action === "prev") show(current - 1);
      else if (action === "next") show(current + 1);
      else if (action === "close" || e.target === dialog) dialog.close();
    });

    dialog.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") show(current - 1);
      else if (e.key === "ArrowRight") show(current + 1);
    });

    // Swipe left/right on touch screens.
    let startX: number | null = null;
    dialog.addEventListener(
      "touchstart",
      (e) => (startX = e.touches[0].clientX),
      { passive: true },
    );
    dialog.addEventListener("touchend", (e) => {
      if (startX === null) return;
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
      startX = null;
    });

    // Return focus to the photo that was open.
    dialog.addEventListener("close", () => links[current]?.focus());
  }
</script>

<style>
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(4, 7, 13, 0.94);
    color: #fff;
  }
  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.6);
  }
  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lightbox figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    pointer-events: none;
  }
  .lightbox img {
    max-width: calc(100vw - 7rem);
    max-height: calc(100dvh - 6rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 0.375rem;
    pointer-events: auto;
  }
  .lightbox figcaption {
    display: flex;
    gap: 1rem;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.75);
  }
  .lb-count {
    color: rgba(255, 255, 255, 0.45);
    font-size: 0.75rem;
  }
  .lb-btn {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    transition: background 0.15s;
  }
  .lb-btn:hover,
  .lb-btn:focus-visible {
    background: rgba(255, 255, 255, 0.2);
    outline: none;
  }
  .lb-btn svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .lb-close {
    top: 1rem;
    right: 1rem;
  }
  .lb-prev,
  .lb-next {
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-prev {
    left: 0.75rem;
  }
  .lb-next {
    right: 0.75rem;
  }
  @media (max-width: 640px) {
    .lightbox img {
      max-width: 100vw;
      border-radius: 0;
    }
    .lb-prev,
    .lb-next {
      top: auto;
      bottom: 1rem;
      transform: none;
    }
  }
</style>
