---
import PageHero from "@/components/PageHero.astro";
import Base from "@/layouts/Base.astro";

const title = "Join KARC";
const description = "Become a member to support the repeaters, events, and training that keeps KARC active.";
const meta_title = "KARC - Join";
const image = "/images/hero-mountains.jpg";
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <PageHero
    eyebrow="Membership"
    title={title}
    subtitle={description}
    image={image}
  />

  <!-- HOW TO JOIN -->
  <section class="section-md">
    <div class="max-w-[1100px] mx-auto px-6 space-y-8">
      <!-- ONLINE MEMBERSHIP -->
      <article class="w4-card p-8 md:p-10 text-center space-y-4 border-2 border-white/20">
        <p class="text-xs uppercase tracking-wide text-white/60">Fastest way to join</p>
        <h2 class="text-2xl md:text-3xl font-extrabold text-white leading-snug">Join or Renew Online</h2>
        <p class="text-base text-white/80 max-w-2xl mx-auto">
          Sign up as a new member or pay your annual dues online through our membership system.
        </p>
        <a
          class="btn btn-primary inline-flex items-center justify-center px-8 py-4 text-lg font-bold"
          href="https://members.w4trc.org/"
        >
          Join &amp; Pay Dues Online &rarr;
        </a>
        <p class="text-xs text-white/60">members.w4trc.org</p>
        <p class="text-sm text-white/75">
          Need help?
          <a class="underline" href="https://youtu.be/Nt9OISBlQr4" target="_blank" rel="noopener noreferrer">
            Watch how to pay your dues online
          </a>
        </p>
      </article>

      <div class="grid gap-6 md:grid-cols-2">
        <article class="w4-card p-6 space-y-3">
          <div>
            <p class="text-xs uppercase tracking-wide text-white/60">Dues</p>
            <h2 class="text-xl font-bold text-white leading-snug">Membership Rates</h2>
          </div>
          <ul class="list-disc list-inside text-sm text-white/80 space-y-2">
            <li>$20 per year for an individual</li>
            <li>$30 per year for a family</li>
          </ul>
          <p class="text-sm text-white/75">
            Membership is for one year. It helps pay for repeater upkeep, site costs, insurance, and club events.
          </p>
        </article>

        <article class="w4-card p-6 space-y-3">
          <div>
            <p class="text-xs uppercase tracking-wide text-white/60">Prefer paper?</p>
            <h2 class="text-xl font-bold text-white leading-snug">Mail a Check</h2>
          </div>
          <p class="text-sm text-white/75">
            Please mail your check to the club treasurer at the address below. Include your name, callsign,
            phone, email, and whether this is an individual or family membership.
          </p>
          <div class="w4-card p-4 bg-white/5 border border-white/10">
            <p class="text-sm text-white/75 font-semibold">KARC</p>
            <p class="text-sm text-white/70">C/O Rick Curtis</p>
            <p class="text-sm text-white/70">102 Mountain View Drive</p>
            <p class="text-sm text-white/70">Mount Carmel, TN 37645</p>
          </div>
        </article>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <article class="w4-card p-6 space-y-3">
          <div>
            <p class="text-xs uppercase tracking-wide text-white/60">Eligibility</p>
            <h2 class="text-xl font-bold text-white leading-snug">Amateur Radio Operators Only</h2>
          </div>
          <p class="text-sm text-white/75">
            Members must be licensed amateur radio operators. Please include your callsign with your payment.
          </p>
          <div class="w4-card p-4 bg-white/5 border border-white/10 space-y-2">
            <p class="text-sm text-white/80 font-semibold">Need a license?</p>
            <ul class="list-disc list-inside text-sm text-white/75 space-y-1">
              <li>Study with online resources or local mentors.</li>
              <li>Schedule a VE exam session; see <a class="underline" href="/resources/license-testing/">License Testing</a>.</li>
              <li>Receive your callsign from the FCC, then join the club.</li>
            </ul>
          </div>
        </article>

        <article class="w4-card p-6 space-y-3">
          <div>
            <p class="text-xs uppercase tracking-wide text-white/60">Benefits</p>
            <h2 class="text-xl font-bold text-white leading-snug">What you get</h2>
          </div>
          <ul class="list-disc list-inside text-sm text-white/80 space-y-2">
            <li>Support for club repeaters and infrastructure.</li>
            <li>Access to the club newsletter and event email updates.</li>
            <li>Participation in meetings, nets, projects, and public service events.</li>
          </ul>
        </article>
      </div>

      <div class="w4-card p-6 space-y-3">
        <div>
          <p class="text-xs uppercase tracking-wide text-white/60">Questions</p>
          <h2 class="text-xl font-bold text-white leading-snug">Need help before you join?</h2>
        </div>
        <p class="text-sm text-white/75">
          Reach out if you have questions about dues, mailing, or licensing. We are happy to help new operators get on the air.
        </p>
        <a class="button inline-flex items-center justify-center px-4 py-2 text-sm font-semibold underline" href="/contact/">
          Contact the Club
        </a>
      </div>
    </div>
  </section>
</Base>
