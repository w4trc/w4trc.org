---
import Base from "@/layouts/Base.astro";
import PageHero from "@/components/PageHero.astro";
import ImageMod from "@/components/ImageMod.astro";
import CalendarSubscribe from "@/components/CalendarSubscribe.astro";
import { getCollection } from "astro:content";
import {
  formatFloatingDate,
  formatFloatingTime,
  getEasternNow,
  parseFloatingIso,
} from "@/lib/utils/floatingDate";

const meetingCover = "/images/clubmeetings2025.jpg";

const eventsRaw = await getCollection("events");
const meetingsRaw = await getCollection("meetings");

const normalizeEvent = (e: any) => ({
  type: "Event" as const,
  title: e.data.title,
  date: e.data.date,
  endDate: (e.data as any).endDate ?? null,
  location: e.data.location ?? "",
  summary: e.data.summary ?? "",
  cover: (e.data as any).cover ?? "",
  link: `/events/${e.id}/`,
});

const normalizeMeeting = (m: any) => {
  return {
    type: "Meeting" as const,
    title: m.data.title ?? "Club Meeting",
    date: m.data.datetime,
    endDate: (m.data as any).endDate ?? null,
    location: m.data.location ?? "",
    summary: m.data.desc ?? m.data.topic ?? "",
    cover: meetingCover,
    link: "/meetings/",
  };
};

const combined = [
  ...eventsRaw.map(normalizeEvent),
  ...meetingsRaw.filter((m) => !m.data.draft && m.data.datetime).map(normalizeMeeting),
].filter((item) => {
  const d = parseFloatingIso(item.date);
  return !!d;
});

combined.sort((a, b) => {
  const da = parseFloatingIso(a.date)?.getTime() ?? 0;
  const db = parseFloatingIso(b.date)?.getTime() ?? 0;
  return da - db;
});

const now = getEasternNow();
const upcoming = combined.filter((e) => {
  const d = parseFloatingIso(e.date);
  return d ? d.getTime() >= now.getTime() : false;
});
const past = combined
  .filter((e) => {
    const d = parseFloatingIso(e.date);
    return d ? d.getTime() < now.getTime() : false;
  })
  .reverse();

const fmtDate = (value: string | Date) => formatFloatingDate(value);
const fmtTime = (value: string | Date) => formatFloatingTime(value);
---

<Base
  title="Events"
  meta_title="KARC - Events"
  description="Upcoming Kingsport Amateur Radio Club events: monthly meetings, license test sessions, Field Day, special event stations, and more."
  image={undefined}
>
  <PageHero
    eyebrow="Club calendar"
    title="Upcoming Events"
    subtitle="Club meetings, test sessions, and special activities."
  />

  <section class="section-md">
    <div class="max-w-[1100px] mx-auto px-6 text-center">
      <CalendarSubscribe class="max-w-2xl mx-auto mb-10" />

      {upcoming.length > 0 ? (
        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 text-left">
          {upcoming.map((item) => (
            <li class="w4-card w4-card-link overflow-hidden p-0!">
              {item.type === "Event" ? (
                <a href={item.link} class="block p-6 h-full">
                  {item.cover && (
                    <ImageMod
                      src={item.cover}
                      width={800}
                      height={450}
                      format="webp"
                      alt={item.title}
                      class="rounded-md mb-4 w-full aspect-video object-cover"
                      loading="lazy"
                      decoding="async"
                    />
                  )}

                  <h2 class="text-2xl font-bold text-white mb-2">
                    {item.title}
                  </h2>

                  <p class="text-gray-400 text-sm mb-3">
                    {fmtDate(item.date)}  ·  {fmtTime(item.date)}
                    {item.location ? `  ·  ${item.location}` : ""}
                  </p>

                  {item.summary && (
                    <p class="text-gray-300 mb-3">{item.summary}</p>
                  )}

                  <span class="inline-flex items-center gap-1 text-(--w4-accent) font-semibold text-sm">
                    More info <span aria-hidden="true">→</span>
                  </span>
                </a>
              ) : (
                <div class="block p-6 h-full">
                  {item.cover && (
                    <ImageMod
                      src={item.cover}
                      width={800}
                      height={450}
                      format="webp"
                      alt={item.title}
                      class="rounded-md mb-4 w-full aspect-video object-cover"
                      loading="lazy"
                      decoding="async"
                    />
                  )}

                  <h2 class="text-2xl font-bold text-white mb-2">
                    {item.title}
                  </h2>

                  <p class="text-gray-400 text-sm mb-3">
                    {fmtDate(item.date)}  ·  {fmtTime(item.date)}
                    {item.location ? `  ·  ${item.location}` : ""}
                  </p>

                  {item.summary && (
                    <p class="text-gray-300">{item.summary}</p>
                  )}
                </div>
              )}
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-gray-400 text-center">No upcoming events listed yet.</p>
      )}

      {past.length > 0 && (
        <>
          <div class="mt-20 mb-8 text-left">
            <div class="eyebrow mb-2">Looking back</div>
            <h2 class="section-title mb-0! before:hidden">Past Events</h2>
          </div>
          <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 text-left">
            {past.map((item) => (
              <li class="w4-card w4-card-link overflow-hidden p-0!">
                {item.type === "Event" ? (
                  <a href={item.link} class="block p-6 h-full">
                    {item.cover && (
                      <ImageMod
                        src={item.cover}
                        width={800}
                        height={450}
                        format="webp"
                        alt={item.title}
                        class="rounded-md mb-4 w-full aspect-video object-cover opacity-80"
                        loading="lazy"
                        decoding="async"
                      />
                    )}

                    <h3 class="text-xl font-semibold text-white mb-2">
                      {item.title}
                    </h3>

                    <p class="text-gray-400 text-sm mb-3">
                      {fmtDate(item.date)}  ·  {fmtTime(item.date)}
                      {item.location ? `  ·  ${item.location}` : ""}
                    </p>

                    <span class="inline-flex items-center gap-1 text-(--w4-accent) font-semibold text-sm">
                      More info <span aria-hidden="true">→</span>
                    </span>
                  </a>
                ) : (
                  <div class="block p-6 h-full">
                    {item.cover && (
                      <ImageMod
                        src={item.cover}
                        width={800}
                        height={450}
                        format="webp"
                        alt={item.title}
                        class="rounded-md mb-4 w-full aspect-video object-cover opacity-80"
                        loading="lazy"
                        decoding="async"
                      />
                    )}

                    <h3 class="text-xl font-semibold text-white mb-2">
                      {item.title}
                    </h3>

                    <p class="text-gray-400 text-sm">
                      {fmtDate(item.date)}  ·  {fmtTime(item.date)}
                      {item.location ? `  ·  ${item.location}` : ""}
                    </p>
                  </div>
                )}
              </li>
            ))}
          </ul>
        </>
      )}
    </div>
  </section>
</Base>
