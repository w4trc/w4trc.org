---
import { getCollection, getEntry, render } from "astro:content";
import Base from "@/layouts/Base.astro";
import ImageMod from "@/components/ImageMod.astro";
import {
  formatFloatingDate,
  formatFloatingTime,
  isSameFloatingDay,
  parseFloatingIso,
  toEasternIso,
} from "@/lib/utils/floatingDate";

export const prerender = true;

export async function getStaticPaths() {
  const events = await getCollection("events");
  return events.map((e) => ({ params: { slug: e.id } }));
}

const { slug } = Astro.params;
const event = await getEntry("events", slug);
if (!event) throw new Error(`Event not found: ${slug}`);

const { data } = event;
const { Content } = await render(event);

const fmtDate = (value) => formatFloatingDate(value);
const fmtTime = (value) => formatFloatingTime(value);

const startDate = parseFloatingIso(data.date);
const endDate = data.endDate ? parseFloatingIso(data.endDate) : null;
const sameDay = startDate && endDate ? isSameFloatingDay(startDate, endDate) : false;
const dateLine = endDate
  ? sameDay
    ? `${fmtDate(data.date)} | ${fmtTime(data.date)}-${fmtTime(data.endDate)}`
    : `${fmtDate(data.date)} ${fmtTime(data.date)}–${fmtDate(data.endDate)} ${fmtTime(data.endDate)}`
  : `${fmtDate(data.date)} | ${fmtTime(data.date)}`;

// schema.org Event data so Google can list the event. Only for indexed events
// held at a real place: Google requires a physical location, so events like
// "Working from home" or "N/A" are skipped.
// "Venue Name (123 Street, City, ST 00000)" -> venue + address
const locMatch = /^(.*?)\s*\((.+)\)\s*$/.exec(data.location ?? "");
const hasPlace = !!data.location && !/^(n\/a|tbd|working from home|online)$/i.test(data.location.trim());
const eventJsonLd =
  !data.noindex && hasPlace
    ? {
        "@context": "https://schema.org",
        "@type": "Event",
        name: data.title,
        startDate: toEasternIso(data.date),
        ...(data.endDate ? { endDate: toEasternIso(data.endDate) } : {}),
        eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
        eventStatus: "https://schema.org/EventScheduled",
        location: {
          "@type": "Place",
          name: locMatch ? locMatch[1] : data.location,
          address: locMatch ? locMatch[2].replace(/\s+/g, " ") : data.location,
        },
        ...(data.summary ? { description: data.summary } : {}),
        ...(data.cover ? { image: [new URL(data.cover, Astro.site).href] } : {}),
        organizer: {
          "@type": "Organization",
          name: "Kingsport Amateur Radio Club",
          url: "https://w4trc.org/",
        },
      }
    : undefined;
---

<Base
  title={data.title}
  meta_title={`KARC - ${data.title}`}
  description={data.summary}
  image={data.cover}
  noindex={data.noindex}
  jsonLd={eventJsonLd}
>
  <!-- Breadcrumb -->
<nav class="py-4">
  <div class="max-w-[1100px] mx-auto px-6 text-sm">
    <a href="/events/" class="text-gray-300 hover:text-white underline underline-offset-4">
      &larr; Back to Events
    </a>
  </div>
</nav>

<!-- Single outer section to avoid alternating backgrounds -->
<section class="section-md">
  <div class="max-w-[900px] mx-auto px-6 text-center">
    {data.cover && (
      <ImageMod
        src={data.cover}
        width={768}
        format="webp"
        alt={data.title}
        class="max-w-sm w-full mx-auto rounded-lg shadow mb-6"
        loading="eager"
        decoding="async"
      />
    )}

    <h1 class="text-4xl font-extrabold mb-2">{data.title}</h1>
    {data.summary && (
      <p class="text-lg text-gray-200 mb-8 max-w-2xl mx-auto">{data.summary}</p>
    )}

    <!-- Centered divider -->
    <div class="relative flex justify-center mb-8">
      <span class="inline-block h-1 w-12 bg-[var(--w4-accent)] rounded-full"></span>
    </div>

    <!-- Keep ONLY this details block -->
    <div class="text-left mb-10">
      <h2 class="text-2xl font-bold text-center mb-6 text-white">Event Details</h2>
      <ul class="space-y-3 text-gray-200 text-base leading-relaxed">
        <li>
          <strong class="text-white font-semibold">When:</strong> {dateLine}
        </li>
        {data.location && (
          <li>
            <strong class="text-white font-semibold">Location:</strong> {data.location}
          </li>
        )}
      </ul>
      {data.rsvpUrl && (
        <div class="mt-6 flex flex-wrap gap-3 justify-center">
          <a
            class="px-4 py-2 rounded-xl border border-white/20 text-white/90"
            href={data.rsvpUrl}
          >
            RSVP
          </a>
        </div>
      )}
    </div>

    <!-- Markdown Content (no box) -->
    <div class="text-left">
      <div class="prose prose-invert max-w-none event-body">
        <Content />
      </div>
    </div>
  </div>
</section>

<style>
  /* Improve readability */
  .event-body { color: var(--w4-ink); font-size: 1.05rem; line-height: 1.75; }
  .event-body p { color: rgba(255,255,255,.9); }
  .event-body a { color: var(--w4-accent); text-decoration: underline; }

  /* Ensure no card-like panels leak into markdown */
  .event-body :where(.w4-card,.meeting-box,.quicklink-card,.news-card,blockquote,pre,code){
    background: transparent !important; border: 0 !important; box-shadow: none !important;
  }
</style>

</Base>



