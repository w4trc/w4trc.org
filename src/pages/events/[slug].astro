---
import { getCollection, getEntry, render } from "astro:content";
import Base from "@/layouts/Base.astro";
import ImageMod from "@/components/ImageMod.astro";
import PageHero from "@/components/PageHero.astro";
import {
  formatFloatingDate,
  formatFloatingTime,
  isSameFloatingDay,
  parseFloatingIso,
  toEasternIso,
} from "@/lib/utils/floatingDate";

export const prerender = true;

export async function getStaticPaths() {
  const events = await getCollection("events");
  return events.map((e) => ({ params: { slug: e.id } }));
}

const { slug } = Astro.params;
const event = await getEntry("events", slug);
if (!event) throw new Error(`Event not found: ${slug}`);

const { data } = event;
const { Content } = await render(event);

const fmtDate = (value) => formatFloatingDate(value);
const fmtTime = (value) => formatFloatingTime(value);

const startDate = parseFloatingIso(data.date);
const endDate = data.endDate ? parseFloatingIso(data.endDate) : null;
const sameDay = startDate && endDate ? isSameFloatingDay(startDate, endDate) : false;
const dateLine = endDate
  ? sameDay
    ? `${fmtDate(data.date)} · ${fmtTime(data.date)}–${fmtTime(data.endDate)}`
    : `${fmtDate(data.date)} ${fmtTime(data.date)}–${fmtDate(data.endDate)} ${fmtTime(data.endDate)}`
  : `${fmtDate(data.date)} · ${fmtTime(data.date)}`;

// Google Calendar link for this event. Times are floating Eastern, so pass the
// wall-clock fields with ctz rather than converting to UTC. Default 2 hours.
let calendarUrl: string | undefined;
if (startDate) {
  const end = endDate ?? new Date(startDate.getTime() + 2 * 60 * 60 * 1000);
  const fmt = (d: Date) => d.toISOString().replace(/[-:]/g, "").slice(0, 15);
  calendarUrl = `https://calendar.google.com/calendar/render?${new URLSearchParams({
    action: "TEMPLATE",
    text: `KARC ${data.title}`,
    dates: `${fmt(startDate)}/${fmt(end)}`,
    ctz: "America/New_York",
    details: [data.summary, new URL(Astro.url.pathname, "https://w4trc.org").href].filter(Boolean).join("\n"),
    location: data.location ?? "",
  })}`;
}

// schema.org Event data so Google can list the event. Only for indexed events
// held at a real place: Google requires a physical location, so events like
// "Working from home" or "N/A" are skipped.
// "Venue Name (123 Street, City, ST 00000)" -> venue + address
const locMatch = /^(.*?)\s*\((.+)\)\s*$/.exec(data.location ?? "");
const hasPlace = !!data.location && !/^(n\/a|tbd|working from home|online)$/i.test(data.location.trim());
const eventJsonLd =
  !data.noindex && hasPlace
    ? {
        "@context": "https://schema.org",
        "@type": "Event",
        name: data.title,
        startDate: toEasternIso(data.date),
        ...(data.endDate ? { endDate: toEasternIso(data.endDate) } : {}),
        eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
        eventStatus: "https://schema.org/EventScheduled",
        location: {
          "@type": "Place",
          name: locMatch ? locMatch[1] : data.location,
          address: locMatch ? locMatch[2].replace(/\s+/g, " ") : data.location,
        },
        ...(data.summary ? { description: data.summary } : {}),
        ...(data.cover ? { image: [new URL(data.cover, Astro.site).href] } : {}),
        organizer: {
          "@type": "Organization",
          name: "Kingsport Amateur Radio Club",
          url: "https://w4trc.org/",
        },
      }
    : undefined;
---

<Base
  title={data.title}
  meta_title={`KARC - ${data.title}`}
  description={data.summary}
  image={data.cover}
  noindex={data.noindex}
  jsonLd={eventJsonLd}
>
  <PageHero
    back={{ href: "/events/", label: "All events" }}
    eyebrow={dateLine}
    title={data.title}
    subtitle={data.summary}
  />

  <section class="section-md">
    <div class="max-w-[1100px] mx-auto px-6 grid gap-10 lg:grid-cols-[minmax(0,1fr)_340px] items-start">
      <aside class="w4-card p-3! lg:order-2 lg:sticky lg:top-28">
        {data.cover && (
          <ImageMod
            src={data.cover}
            width={768}
            format="webp"
            alt={data.title}
            class="w-full rounded-[0.9rem] mb-2"
            loading="eager"
            decoding="async"
          />
        )}
        <dl class="space-y-4 p-4 text-sm">
          <div>
            <dt class="eyebrow text-white/45!">When</dt>
            <dd class="mt-1 font-medium text-white">{dateLine}</dd>
          </div>
          {data.location && (
            <div>
              <dt class="eyebrow text-white/45!">Where</dt>
              <dd class="mt-1 font-medium text-white">{data.location}</dd>
            </div>
          )}
        </dl>
        <div class="flex flex-wrap gap-2 px-4 pb-4">
          {data.rsvpUrl && (
            <a class="btn btn-primary btn-sm" href={data.rsvpUrl}>RSVP</a>
          )}
          {calendarUrl && (
            <a class="btn-ghost" href={calendarUrl} target="_blank" rel="noopener noreferrer">Add to Calendar</a>
          )}
        </div>
      </aside>

      <div class="content event-body lg:order-1">
        <Content />
      </div>
    </div>
  </section>

<style>
  .event-body {
    font-size: 1.05rem;
    line-height: 1.75;
  }
  /* Ensure no card-like panels leak into markdown */
  .event-body :global(:where(.w4-card, .meeting-box, .quicklink-card, .news-card, pre, code)) {
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
  }
</style>

</Base>



