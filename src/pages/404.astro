---
import Base from "@/layouts/Base.astro";
import PageHero from "@/components/PageHero.astro";
---

<Base title="Page Not Found" description="Sorry, that page could not be found on the Kingsport Amateur Radio Club (W4TRC) website." noindex>
  <PageHero
    eyebrow="Error 404"
    title="Off Frequency"
    subtitle="We tried to tune this page, but all we got was static. It might have moved, changed its call sign, or is taking a coffee break."
  >
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href="/" class="btn btn-primary">Back to home</a>
      <a href="/contact/" class="btn btn-outline-primary">Contact us</a>
    </div>
  </PageHero>
</Base>
